// Measures for the portfolio report. Create an empty table called _Measures
// (Enter data -> one blank column) and add these to it.
//
// Relationships expected (all single direction, dimension -> fact):
//   dim_portfolio[portfolio_id]  1:*  fact_position, fact_perf_daily, fact_trade, risk_summary (1:1)
//   dim_security[ticker]         1:*  fact_position, fact_trade;   1:1  fact_watchlist
//   dim_date[Date]               1:*  fact_perf_daily[bar_date], fact_trade[trade_date]


// ---------- calculated table (Modeling -> New table), then mark as date table ----------

dim_date =
ADDCOLUMNS (
    CALENDAR ( MIN ( fact_perf_daily[bar_date] ), MAX ( fact_perf_daily[bar_date] ) ),
    "Year", YEAR ( [Date] ),
    "Month", FORMAT ( [Date], "yyyy-mm" ),
    "Quarter", "Q" & QUARTER ( [Date] ) & " " & YEAR ( [Date] )
)


// ---------- holdings ----------

Market Value = SUM ( fact_position[market_value] )

Cost Basis = SUM ( fact_position[cost_basis] )

Unrealized P&L = [Market Value] - [Cost Basis]

Unrealized % = DIVIDE ( [Unrealized P&L], [Cost Basis] )

Realized P&L = SUM ( fact_position[realized_pnl] )

Day P&L = SUM ( fact_position[day_pnl] )

// Yesterday's value is today's value minus today's move.
Day % = DIVIDE ( [Day P&L], [Market Value] - [Day P&L] )

Open Positions =
CALCULATE ( COUNTROWS ( fact_position ), fact_position[is_open] = 1 )

Names Held =
CALCULATE ( DISTINCTCOUNT ( fact_position[ticker] ), fact_position[is_open] = 1 )

// Share of whatever is on screen: by ticker in a table, by sector in the donut.
Weight =
DIVIDE ( [Market Value], CALCULATE ( [Market Value], ALLSELECTED ( dim_security ) ) )

Top 5 Weight =
VAR top5 = TOPN ( 5, VALUES ( dim_security[ticker] ), [Market Value], DESC )
RETURN
    DIVIDE ( CALCULATE ( [Market Value], top5 ), CALCULATE ( [Market Value], ALL ( dim_security ) ) )


// ---------- performance (pick one portfolio; blank otherwise) ----------
// Returns come from twr_index, which already strips out deposits/withdrawals,
// so these hold up across periods where money was added to the book.

Period Return =
VAR d0 = MIN ( fact_perf_daily[bar_date] )
VAR d1 = MAX ( fact_perf_daily[bar_date] )
VAR i0 = CALCULATE ( MAX ( fact_perf_daily[twr_index] ), fact_perf_daily[bar_date] = d0 )
VAR i1 = CALCULATE ( MAX ( fact_perf_daily[twr_index] ), fact_perf_daily[bar_date] = d1 )
RETURN
    IF ( HASONEVALUE ( dim_portfolio[portfolio_id] ), DIVIDE ( i1, i0 ) - 1 )

SPY Period Return =
VAR d0 = MIN ( fact_perf_daily[bar_date] )
VAR d1 = MAX ( fact_perf_daily[bar_date] )
VAR b0 = CALCULATE ( MAX ( fact_perf_daily[bench_index] ), fact_perf_daily[bar_date] = d0 )
VAR b1 = CALCULATE ( MAX ( fact_perf_daily[bench_index] ), fact_perf_daily[bar_date] = d1 )
RETURN
    IF ( HASONEVALUE ( dim_portfolio[portfolio_id] ), DIVIDE ( b1, b0 ) - 1 )

Excess vs SPY = [Period Return] - [SPY Period Return]

// For the line chart: growth rebased to 0% at the start of the date slicer.
Cumulative Return =
VAR startDate = CALCULATE ( MIN ( fact_perf_daily[bar_date] ), ALLSELECTED ( dim_date ) )
VAR base =
    CALCULATE ( MAX ( fact_perf_daily[twr_index] ), REMOVEFILTERS ( dim_date ),
                fact_perf_daily[bar_date] = startDate )
RETURN
    IF ( HASONEVALUE ( dim_portfolio[portfolio_id] ),
         DIVIDE ( MAX ( fact_perf_daily[twr_index] ), base ) - 1 )

SPY Cumulative Return =
VAR startDate = CALCULATE ( MIN ( fact_perf_daily[bar_date] ), ALLSELECTED ( dim_date ) )
VAR base =
    CALCULATE ( MAX ( fact_perf_daily[bench_index] ), REMOVEFILTERS ( dim_date ),
                fact_perf_daily[bar_date] = startDate )
RETURN
    IF ( HASONEVALUE ( dim_portfolio[portfolio_id] ),
         DIVIDE ( MAX ( fact_perf_daily[bench_index] ), base ) - 1 )

// Drawdown from the running peak inside the selected window (risk_summary has
// the since-inception figure).
Drawdown =
VAR d = MAX ( dim_date[Date] )
VAR startDate = CALCULATE ( MIN ( fact_perf_daily[bar_date] ), ALLSELECTED ( dim_date ) )
VAR peak =
    CALCULATE ( MAX ( fact_perf_daily[twr_index] ), REMOVEFILTERS ( dim_date ),
                fact_perf_daily[bar_date] >= startDate, fact_perf_daily[bar_date] <= d )
RETURN
    IF ( HASONEVALUE ( dim_portfolio[portfolio_id] ),
         DIVIDE ( MAX ( fact_perf_daily[twr_index] ), peak ) - 1 )

Ann. Volatility = STDEV.S ( fact_perf_daily[daily_return] ) * SQRT ( 252 )

Max Drawdown (inception) = MIN ( risk_summary[max_drawdown] )

Beta vs SPY = AVERAGE ( risk_summary[beta] )

Sharpe = AVERAGE ( risk_summary[sharpe] )


// ---------- market monitor (whole universe, not filtered by portfolio) ----------

Universe Size = COUNTROWS ( fact_watchlist )

Advancers = CALCULATE ( COUNTROWS ( fact_watchlist ), fact_watchlist[day_change_pct] > 0 )

Decliners = CALCULATE ( COUNTROWS ( fact_watchlist ), fact_watchlist[day_change_pct] < 0 )

Median Move = MEDIAN ( fact_watchlist[day_change_pct] )

Within 2% of 52w High =
CALCULATE ( COUNTROWS ( fact_watchlist ), fact_watchlist[pct_off_high] >= -0.02 )

Volume vs 30d Avg =
DIVIDE ( SUM ( fact_watchlist[day_volume] ), SUM ( fact_watchlist[avg_volume_30d] ) )

// Below 100% means some names fell back to the last close.
Live Quote Coverage =
DIVIDE (
    CALCULATE ( COUNTROWS ( fact_watchlist ), fact_watchlist[price_source] = "intraday" ),
    [Universe Size]
)

Prices As Of =
"Prices as of " & FORMAT ( MAX ( refresh_info[last_quote_pull] ), "d mmm yyyy hh:nn" ) & " UTC"
