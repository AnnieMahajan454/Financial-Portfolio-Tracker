{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "hoSectorBar",
  "position": {
    "x": 868,
    "y": 248,
    "z": 10000,
    "width": 396,
    "height": 460,
    "tabOrder": 10000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_security"
                    }
                  },
                  "Property": "sector"
                }
              },
              "queryRef": "dim_security.sector",
              "nativeQueryRef": "Sector",
              "displayName": "Sector"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_position"
                    }
                  },
                  "Property": "Position Weight"
                }
              },
              "queryRef": "fact_position.Position Weight",
              "nativeQueryRef": "Weight",
              "displayName": "Weight"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "fact_position"
                  }
                },
                "Property": "Position Weight"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Weight by sector'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
