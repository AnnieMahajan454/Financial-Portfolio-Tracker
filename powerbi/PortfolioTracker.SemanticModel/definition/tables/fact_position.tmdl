table fact_position
	lineageTag: 6435884f-cf56-58b6-9f2c-ba2ac56108b7

	measure 'Market Value' = CALCULATE ( SUM ( fact_position[market_value] ), fact_position[is_open] = 1 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Holdings
		lineageTag: f98bc4bf-17f8-505c-aabf-ee1ae81360bd

	measure 'Cost Basis' = CALCULATE ( SUM ( fact_position[cost_basis] ), fact_position[is_open] = 1 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Holdings
		lineageTag: d334cdf4-6aa6-5548-9195-3d5dd54e50d2

	measure 'Unrealized P&L' = [Market Value] - [Cost Basis]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Holdings
		lineageTag: 4e094217-f84d-5b96-b47d-044a94d2bba6

	measure 'Unrealized %' = DIVIDE ( [Unrealized P&L], [Cost Basis] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Holdings
		lineageTag: 8b4fb75b-c956-550a-afb1-b97be77750ca

	measure 'Realized P&L' = SUM ( fact_position[realized_pnl] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Holdings
		lineageTag: d553e1fb-7382-5a72-b856-d42110d0f9cd

	measure 'Day P&L' = CALCULATE ( SUM ( fact_position[day_pnl] ), fact_position[is_open] = 1 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Holdings
		lineageTag: 1764dd95-9667-556c-ade7-839d0d5fadd8

	measure 'Day %' =
			// yesterday's value is today's value minus today's move
			DIVIDE ( [Day P&L], [Market Value] - [Day P&L] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Holdings
		lineageTag: 5ff8413c-232e-5465-858f-d635ae3e8830

	measure 'Shares' = CALCULATE ( SUM ( fact_position[qty] ), fact_position[is_open] = 1 )
		formatString: #,0
		displayFolder: Holdings
		lineageTag: 6a8c32a0-eff2-58b3-a007-5082203011e1

	measure 'Avg Cost' = DIVIDE ( [Cost Basis], [Shares] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Holdings
		lineageTag: c616a057-db36-534d-b23f-235f4279d767

	measure 'Last Price' = CALCULATE ( MAX ( fact_position[price] ), fact_position[is_open] = 1 )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Holdings
		lineageTag: e32dc071-05ac-5c05-9aa0-5b1f0872227c

	measure 'Names Held' = CALCULATE ( DISTINCTCOUNT ( fact_position[ticker] ), fact_position[is_open] = 1 )
		formatString: #,0
		displayFolder: Holdings
		lineageTag: 4deb98e0-1c58-58f7-9b49-4a1f619b02f0

	measure 'Position Weight' =
			// share of whatever is on screen: per ticker in the table, per sector in the donut
			DIVIDE ( [Market Value], CALCULATE ( [Market Value], ALLSELECTED ( dim_security ) ) )
		formatString: 0.0%
		displayFolder: Holdings
		lineageTag: b1f0a03e-ff86-5587-af61-653fe0c310da

	measure 'Top 5 Weight' =
			VAR top5 = TOPN ( 5, VALUES ( dim_security[ticker] ), [Market Value], DESC )
			RETURN
			    DIVIDE ( CALCULATE ( [Market Value], top5 ), CALCULATE ( [Market Value], ALL ( dim_security ) ) )
		formatString: 0.0%
		displayFolder: Holdings
		lineageTag: 1b22d8f0-ad30-53c3-a9c0-f4beab0bd60e

	measure 'P&L Color' = SWITCH ( TRUE (), [Unrealized %] > 0, "#1A7F37", [Unrealized %] < 0, "#C62828", "#57606A" )
		displayFolder: Formatting
		lineageTag: 84489776-9098-5b91-af12-75a95e9fe682

	measure 'Day P&L Color' = SWITCH ( TRUE (), [Day P&L] > 0, "#1A7F37", [Day P&L] < 0, "#C62828", "#57606A" )
		displayFolder: Formatting
		lineageTag: 51100562-2110-5100-b64b-cc410f92d932

