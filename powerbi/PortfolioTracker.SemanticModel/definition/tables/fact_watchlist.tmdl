table fact_watchlist
	lineageTag: 487807f1-cc23-5955-a133-0bec683ea545

	measure 'Universe Size' = COUNTROWS ( fact_watchlist )
		formatString: #,0
		displayFolder: Market
		lineageTag: 2b56929d-3f89-546b-8f63-98590251e4a1

	measure 'Advancers' = CALCULATE ( COUNTROWS ( fact_watchlist ), fact_watchlist[day_change_pct] > 0 )
		formatString: #,0
		displayFolder: Market
		lineageTag: 5f0eb799-b3c3-537f-9d2b-9266cd96ea5f

	measure 'Decliners' = CALCULATE ( COUNTROWS ( fact_watchlist ), fact_watchlist[day_change_pct] < 0 )
		formatString: #,0
		displayFolder: Market
		lineageTag: ce0efe1b-1f71-518a-8e09-392435632c8f

	measure 'Median Move' = MEDIAN ( fact_watchlist[day_change_pct] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Market
		lineageTag: 8a3fb391-651a-5163-8fd9-5fa3910bb417

	measure 'Day Move %' = AVERAGE ( fact_watchlist[day_change_pct] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Market
		lineageTag: 2ff99cbf-5425-55d9-9289-ad1b1e46df81

	measure 'Last Trade' = MAX ( fact_watchlist[price] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Market
		lineageTag: 4aa014bf-c473-5743-aa5f-ec8cbe42bd35

	measure 'Off 52w High' = AVERAGE ( fact_watchlist[pct_off_high] )
		formatString: 0.0%
		displayFolder: Market
		lineageTag: 461c42c8-a206-5524-bd3c-85434cde233a

	measure 'Near 52w High' = CALCULATE ( COUNTROWS ( fact_watchlist ), fact_watchlist[pct_off_high] >= -0.02 )
		formatString: #,0
		displayFolder: Market
		lineageTag: 8330ea80-9cd7-5f30-8632-8029bd771036

	measure 'Dollar Volume 30d' =
			// average daily traded value, used to size the treemap
			SUMX ( fact_watchlist, fact_watchlist[price] * fact_watchlist[avg_volume_30d] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Market
		lineageTag: d8021ab5-09dd-5e34-95f9-be06399d5acb

	measure 'Live Quote Coverage' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_watchlist ), fact_watchlist[price_source] = "intraday" ),
			    [Universe Size]
			)
		formatString: 0.0%
		displayFolder: Market
		lineageTag: 46082ee8-2f6e-5639-8cbc-1826e8498f51

	measure 'Move Color' =
			VAR m = [Day Move %]
			RETURN
			    SWITCH ( TRUE (),
			        m >= 0.02, "#116329",
			        m >= 0.005, "#2DA44E",
			        m > -0.005, "#AFB8C1",
			        m > -0.02, "#E5534B",
			        "#A40E26" )
		displayFolder: Formatting
		lineageTag: 3e70c4fc-8876-5886-adb3-3adf408514a6

	column ticker
		dataType: string
		isHidden
		lineageTag: 0de8f75c-c5e9-573f-8ca9-c24d6819bb66
		summarizeBy: none
		sourceColumn: ticker

		annotation SummarizationSetBy = User

	column name
