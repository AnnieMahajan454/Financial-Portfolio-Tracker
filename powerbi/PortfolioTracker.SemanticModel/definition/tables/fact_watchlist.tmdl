		formatString: 0
		lineageTag: 6ff1c1e7-642a-5e7e-a9b5-44918517c14a
		summarizeBy: none
		sourceColumn: day_volume

		annotation SummarizationSetBy = User

	column avg_volume_30d
		dataType: double
		formatString: #,0.####
		lineageTag: 5b44be34-86e9-5377-b9b9-d846821608a0
		summarizeBy: none
		sourceColumn: avg_volume_30d

		annotation SummarizationSetBy = User

	column high_52w
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 271f78c4-04c9-562a-acd1-227c9466aa16
		summarizeBy: none
		sourceColumn: high_52w

		annotation SummarizationSetBy = User

	column low_52w
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 33147cf4-9072-5baf-9e25-174104b8017e
		summarizeBy: none
		sourceColumn: low_52w

		annotation SummarizationSetBy = User

	column pct_off_high
		dataType: double
		formatString: 0.00%
		lineageTag: a2e5a008-7353-597c-99cf-ba2c709b50fa
		summarizeBy: none
		sourceColumn: pct_off_high

		annotation SummarizationSetBy = User

	column price_source
		dataType: string
		lineageTag: 41f8149c-7c43-502f-b7e9-e6ceb1a4aabb
		summarizeBy: none
		sourceColumn: price_source

		annotation SummarizationSetBy = User

	column price_time
		dataType: string
		lineageTag: 3c88cacc-5b91-5bfe-af95-55d111013bf7
		summarizeBy: none
